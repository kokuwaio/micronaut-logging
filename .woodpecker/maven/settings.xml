<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0 https://maven.apache.org/xsd/settings-1.3.0.xsd">
	<interactiveMode>false</interactiveMode>
	<localRepository>/woodpecker/.m2</localRepository>
	<servers>
		<server>
			<id>git.kokuwa.io</id>
			<username>${env.FORGEJO_USERNAME}</username>
			<password>${env.FORGEJO_PASSWORD}</password>
			<repositoryOrigins>
				<repositoryOrigin>https://git.kokuwa.io</repositoryOrigin>
			</repositoryOrigins>
		</server>
		<server>
			<id>sonatype.org</id>
			<username>${env.SONATYPE_ORG_USERNAME}</username>
			<password>${env.SONATYPE_ORG_PASSWORD}</password>
			<repositoryOrigins>
				<repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
			</repositoryOrigins>
		</server>
	</servers>
	<mirrors>
		<mirror>
			<url>https://mirror.kokuwa.io/maven2</url>
			<mirrorOf>central</mirrorOf>
		</mirror>
	</mirrors>
</settings>
